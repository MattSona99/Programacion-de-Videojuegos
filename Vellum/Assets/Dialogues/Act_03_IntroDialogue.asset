  m_Script: {fileID: 11500000, guid: 1735c545341a7c841b2ac7f47768a64b, type: 3}
  m_Name: Act_03_IntroDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueId: 
  lines:
  - speaker: Narrator
    text: And so the Wanderer and Jammo crossed the last threshold...
  - speaker: Narrator
    text: '...and found themselves upon a still arena of

      water.'
  - speaker: Narrator
    text: Before them stood a figure that wore the Wanderer's own shape...
  - speaker: Narrator
    text: ...yet reversed, man to woman, a stranger born of their own reflection.
  - speaker: Narrator
    text: 'The ground mirrored the world in a way that should not be:'
  - speaker: Narrator
    text: above, a clear sky and a bright sun;
  - speaker: Narrator
    text: below the surface, a red moon hung in a sky of blood.
  - speaker: Narrator
    text: There was no path back. The reflection raised its guard, and the duel began.
