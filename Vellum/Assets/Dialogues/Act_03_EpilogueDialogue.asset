  m_Script: {fileID: 11500000, guid: 1735c545341a7c841b2ac7f47768a64b, type: 3}
  m_Name: Act_03_EpilogueDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueAsset
  dialogueId:
  lines:
  - speaker: Narrator
    text: At last the reflection faltered, and its raised guard fell away.
  - speaker: Narrator
    text: The stranger that wore the Wanderer's face sank down upon the water...
  - speaker: Narrator
    text: '...and where it fell, the mirrored world began to come apart.'
  - speaker: Narrator
    text: 'The blood-red moon dimmed; the sky beneath the surface cracked like old
      glass.'
  - speaker: Narrator
    text: "Sun and reflection, water and stone — all crumbled into a quiet grey."
  - speaker: Narrator
    text: The Wanderer had looked upon their own shape, and had not been undone by
      it.
  - speaker: Narrator
    text: 'And so, with Jammo at their side, the Wanderer turned from the mirror of
      water...'
  - speaker: Narrator
    text: '...and walked on, into the silence of a duel that, at last, was over.'
